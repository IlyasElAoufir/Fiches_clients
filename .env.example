# =============================================================================
# Novamap Clients — variables d'environnement
# =============================================================================
# Copier ce fichier en `.env.local` et renseigner les valeurs.
# `.env.local` est ignoré par Git — il ne doit JAMAIS être commité.
# AUCUN secret réel ne doit figurer dans ce fichier `.env.example`.
# =============================================================================

# --- SQL Server / Azure SQL -------------------------------------------------
SQL_PROD_SERVER=<serveur-prod>.database.windows.net
SQL_INT_SERVER=<serveur-integration>.database.windows.net
SQL_USER=
SQL_PASSWORD=
SQL_SYSTEM_DATABASE=NovamapSystemDB

# --- Microsoft Entra ID (Azure AD) ------------------------------------------
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# --- Auth.js ----------------------------------------------------------------
# Générer avec : npx auth secret
AUTH_SECRET=
# URL publique de l'application (http://localhost:3000 en dev)
NEXTAUTH_URL=http://localhost:3000

# --- Contrôle d'accès -------------------------------------------------------
# Domaines e-mail autorisés, séparés par des virgules (vérifié côté serveur)
ALLOWED_EMAIL_DOMAINS=novamap.fr

# Client servant d'echantillon aux tests d'API (npm run test:api)
TEST_CLIENT_ID=

# Chemin du classeur source (npm run excel:extract)
FICHES_CLIENTS_XLSX=
